{
  "appId": "com.gentoo.app.desktop",
  "productName": "Gentoo",
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "directories": {
    "output": "desktop-build"
  },
  "files": [
    {
      "from": "dist",
      "to": "dist"
    },
    {
      "from": "electron",
      "to": "electron"
    },
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "mac": {
    "category": "public.app-category.productivity",
    "identity": null,
    "target": ["dmg", "zip"]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false
  }
}
