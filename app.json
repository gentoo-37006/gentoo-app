{
  "expo": {
    "name": "Gentoo",
    "slug": "gentoo-app",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gentoo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.gentoo.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:gentoo.ethanyanxu.com",
        "applinks:beta.gentoo.ethanyanxu.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F7",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "gentoo.ethanyanxu.com",
              "pathPrefix": "/inventory"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.gentoo.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/d6ef0c8d-1dbb-48d0-b4de-fb839dc38e6e",
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAFA",
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 370,
          "android": {
            "image": "./assets/images/splash-icon-android-light.png",
            "imageWidth": 277.5,
            "dark": {
              "image": "./assets/images/splash-icon-android-dark.png"
            }
          },
          "ios": {
            "image": "./assets/images/splash-icon-ios-light.png",
            "dark": {
              "image": "./assets/images/splash-icon-ios-dark.png"
            }
          },
          "dark": {
            "backgroundColor": "#0A0A0A",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D8B4FE",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Gentoo to access your photos to analyze cables.",
          "cameraPermission": "Allow Gentoo to use the camera to photograph cables."
        }
      ],
      "./plugins/withPodfileDeploymentTarget",
      "./plugins/withUISceneSupport"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d6ef0c8d-1dbb-48d0-b4de-fb839dc38e6e"
      }
    },
    "owner": "xxooethanooxx"
  }
}
