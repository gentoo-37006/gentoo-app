{
  "name": "gentoo-app",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gentoo-34755/gentoo-app.git"
  },
  "dependencies": {
    "@expo/ui": "~56.0.18",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "expo": "~56.0.12",
    "expo-auth-session": "~56.0.14",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.11",
    "expo-image-picker": "^56.0.18",
    "expo-linking": "~56.0.14",
    "expo-notifications": "~56.0.18",
    "expo-router": "~56.2.11",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.19",
    "expo-web-browser": "~56.0.5",
    "lucide-react-native": "^1.21.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "^15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios --device",
    "web": "expo start --web",
    "export:web": "expo export --platform web --clear",
    "mac:preview": "npm run export:web && electron electron/main.cjs",
    "mac:installer": "npm run export:web && electron-builder --mac dmg --arm64 --config electron-builder.json",
    "mac:release": "bash scripts/build-signed-mac.sh",
    "win:installer": "npm run export:web && electron-builder --win nsis --x64 --config electron-builder.json",
    "desktop:installer": "npm run mac:release && npm run win:installer",
    "desktop:publish": "npm run export:web && electron-builder --mac dmg --arm64 --win nsis --x64 --config electron-builder.json --publish always",
    "beta:version": "node scripts/beta-version.js",
    "beta:mac": "npm run export:web && electron-builder --mac dmg --arm64 --config electron-builder.json -c.extraMetadata.version=$(node scripts/beta-version.js) -c.appId=com.gentoo.app.beta -c.productName=\"Gentoo Beta\" -c.mac.notarize=true --publish always",
    "beta:win": "npm run export:web && electron-builder --win nsis --x64 --config electron-builder.json -c.extraMetadata.version=$(node scripts/beta-version.js) -c.appId=com.gentoo.app.beta -c.productName=\"Gentoo Beta\" --publish always",
    "update:production": "eas update --branch production",
    "update:preview": "eas update --branch preview",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
