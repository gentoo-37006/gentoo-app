    "eslint-config-expo": "~56.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios --device",
    "web": "expo start --web",
    "export:web": "node scripts/check-public-env.js && expo export --platform web --clear",
    "ios:publish": "bash scripts/build-ios-local.sh",
    "ios:publish:cloud": "eas build -p ios --profile production --submit",
    "ios:publish:auto": "bash scripts/publish-ios.sh",
    "android:apk": "bash scripts/build-android-apk-local.sh",
    "android:apk:cloud": "eas build -p android --profile release-apk",
    "android:apk:auto": "bash scripts/publish-android.sh",
    "release:all": "npm run ios:publish:auto && npm run android:apk:auto && npm run release:collect",
    "release:collect": "bash scripts/collect-release-artifacts.sh",
    "update:production": "node scripts/check-public-env.js && eas update --branch production",
    "update:preview": "node scripts/check-public-env.js && eas update --branch preview",
    "lint": "expo lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:ui": "jest"
  },
  "private": true
}
