# Copy to .env and fill in. All EXPO_PUBLIC_* vars are bundled into the client.

# Supabase project (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional. Use "beta" for beta web builds so Downloads shows beta artifacts.
EXPO_PUBLIC_RELEASE_CHANNEL=release

# Origin the printed inventory QR labels point at. Only used by native builds —
# the web build reads its own origin.
#
# LEAVE THIS UNSET unless you are self-hosting. Setting it overrides the
# channel-aware default in lib/label-origin.ts, which points beta Android
# builds at the beta site (com.gentoo.app.beta claims only that host, so a
# production URL would never open the app the label was printed from).
# EXPO_PUBLIC_WEB_URL=https://parts.example.org
